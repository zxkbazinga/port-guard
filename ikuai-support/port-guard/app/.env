# Port Guard 默认配置
# 爱快应用市场会在用户修改配置后覆盖 app/environment 文件，
# 本文件仅作为未配置时的兜底默认值。
APP_PORT_WEB=8080
PG_IKUAI_HOST=127.0.0.1
PG_IKUAI_PORT=80
PG_IKUAI_USERNAME=admin
PG_IKUAI_PASSWORD=
PG_BAN_MINUTES=30
PG_BAN_MODE=auto
PG_DETECTION_ENABLED=1
PG_SNIFFER_ENABLED=1
PG_SNIFFER_IFACE=any
PG_SYSLOG_ENABLED=1
PG_SYSLOG_PORT=5140
PG_CONN_POLL_ENABLED=0
PG_PORT_REFRESH_ENABLED=1
PG_WINDOW_SECONDS=60
PG_SYN_FLOOD_THRESHOLD=30
PG_PORT_SCAN_THRESHOLD=8
PG_CONN_RATE_THRESHOLD=60
PG_UDP_FLOOD_THRESHOLD=80
PG_WEB_USERNAME=admin
PG_IGNORE_PRIVATE_IPS=1
PG_LOGIN_FAIL_ENABLED=1
PG_LOGIN_FAIL_THRESHOLD=3
PG_LOGIN_FAIL_WINDOW=300
